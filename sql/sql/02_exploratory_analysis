FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
GROUP BY DATE_TRUNC('month', invoicedate)
ORDER BY DATE_TRUNC('month', invoicedate);


SELECT
    TO_CHAR(DATE_TRUNC('month', invoicedate), 'YYYY-MM')
        AS sales_month,
    ROUND(
        (SUM(quantity * unitprice) /
        COUNT(DISTINCT invoiceno))::numeric, 2
    ) AS average_order_value
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
GROUP BY DATE_TRUNC('month', invoicedate)
ORDER BY DATE_TRUNC('month', invoicedate);

-- 4. COUNTRY ANALYSIS
-- Compare revenue and order volume by customer country.

SELECT
    country,
    ROUND(SUM(quantity * unitprice)::numeric, 2)
        AS total_revenue,
    COUNT(DISTINCT invoiceno)
        AS total_orders
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
GROUP BY country
ORDER BY total_revenue DESC
LIMIT 15;

-- 5. PRODUCT PERFORMANCE
-- First: products ranked by units sold.

SELECT
    stockcode,
    description,
    SUM(quantity) AS units_sold,
    ROUND(
        SUM(quantity * unitprice)::numeric, 2
    ) AS total_revenue
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
GROUP BY stockcode, description
HAVING SUM(quantity) > 0
ORDER BY units_sold DESC
LIMIT 15;

-- Initial revenue ranking, before removing non-standard stock codes.
SELECT
    stockcode,
    description,
    SUM(quantity) AS units_sold,
    ROUND(
        SUM(quantity * unitprice)::numeric, 2
    ) AS total_revenue
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
GROUP BY stockcode, description
HAVING SUM(quantity) > 0
ORDER BY total_revenue DESC
LIMIT 15;

-- Refined revenue ranking, excluding non-standard stock codes.
SELECT
    stockcode,
    description,
    SUM(quantity) AS units_sold,
    ROUND(
        SUM(quantity * unitprice)::numeric, 2
    ) AS total_revenue
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
    AND quantity > 0
    AND stockcode NOT IN ('DOT', 'POST', 'M')
GROUP BY stockcode, description
ORDER BY total_revenue DESC
LIMIT 15;

-- 6. CUSTOMER ANALYSIS
-- Highest-spending customers, repeat purchasing and customer spend distribution.

SELECT
    customerid,
    COUNT(DISTINCT invoiceno) AS total_orders,
    SUM(quantity) AS total_items,
    ROUND(
        SUM(quantity * unitprice)::numeric, 2
    ) AS total_spent
FROM online_retail
WHERE invoiceno NOT LIKE 'C%'
    AND customerid IS NOT NULL
    AND quantity > 0
GROUP BY customerid
ORDER BY total_spent DESC
LIMIT 15;

WITH customer_orders AS (
    SELECT
        customerid,
        COUNT(DISTINCT invoiceno) AS total_orders
    FROM online_retail
    WHERE invoiceno NOT LIKE 'C%'
        AND customerid IS NOT NULL
        AND quantity > 0
    GROUP BY customerid
)

SELECT
    COUNT(*) AS total_customers,

    COUNT(*) FILTER (
        WHERE total_orders > 1
    ) AS repeat_customers,

    COUNT(*) FILTER (
        WHERE total_orders = 1
    ) AS one_time_customers,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE total_orders > 1
        ) / COUNT(*),
        2
    ) AS repeat_customer_percentage

FROM customer_orders;

WITH customer_spending AS (
    SELECT
        customerid,
        SUM(quantity * unitprice) AS total_spent
    FROM online_retail
    WHERE invoiceno NOT LIKE 'C%'
        AND customerid IS NOT NULL
        AND quantity > 0
    GROUP BY customerid
)

SELECT
    ROUND(AVG(total_spent)::numeric, 2)
        AS average_customer_spend,

    ROUND(
        PERCENTILE_CONT(0.5)
        WITHIN GROUP (ORDER BY total_spent)::numeric, 2
    ) AS median_customer_spend,

    ROUND(MIN(total_spent)::numeric, 2)
        AS lowest_customer_spend,

    ROUND(MAX(total_spent)::numeric, 2)
        AS highest_customer_spend

FROM customer_spending;

-- 7. DATA QUALITY INVESTIGATIONS
-- Investigate unusual customer totals and zero-/negative-price records.
-- These queries document the checks used to inform the final analysis.

-- Check for customer totals that are zero or negative.
WITH customer_spending AS (
    SELECT
        customerid,
        SUM(quantity * unitprice) AS total_spent
    FROM online_retail
    WHERE invoiceno NOT LIKE 'C%'
        AND customerid IS NOT NULL
        AND quantity > 0
    GROUP BY customerid
)

SELECT *
FROM customer_spending
WHERE total_spent <= 0
ORDER BY total_spent;

